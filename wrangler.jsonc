{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanks",
  "main": "src/server/worker.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "FEEDBACK", "class_name": "FeedbackStore" },
      { "name": "BOARD", "class_name": "Board" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["FeedbackStore"] },
    { "tag": "v3", "new_sqlite_classes": ["Board"] }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true }
  }
}
