{
  "name": "tanks",
  "version": "1.0.0",
  "scripts": {
    "build": "esbuild src/client/main.ts --bundle --format=esm --minify --sourcemap --target=es2022 --outfile=public/client.js",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json"
  },
  "type": "module",
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/three": "^0.170.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.154.0"
  },
  "allowScripts": {
    "workerd@1.20261023.1": true,
    "esbuild@0.28.2": true
  },
  "private": true
}
